[Unit]
Description=xbot 管理サイト（予約投稿・DM自動返信）
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=xbot
Group=xbot
EnvironmentFile=/etc/xbot/env
WorkingDirectory=/opt/xbot
ExecStart=/bin/sh -c 'exec /opt/xbot/venv/bin/gunicorn --bind ${XBOT_BIND}:8090 --workers 1 --threads 4 --timeout 60 xbot.web:app'
Restart=on-failure
RestartSec=5
MemoryMax=300M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xbot

[Install]
WantedBy=multi-user.target
