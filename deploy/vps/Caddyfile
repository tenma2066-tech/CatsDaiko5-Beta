# SITE_HOST 例: 158-101-1-2.sslip.io（IPアドレスの . を - にしたもの）。Let's Encrypt で自動HTTPS。
{$SITE_HOST} {
	encode gzip
	# ミニゲーム（ダイナマイト野球）。dya コンテナが動いていないときは /dya/ だけ 502 になり、お店には影響しない。
	redir /dya /dya/ 308
	handle_path /dya/* {
		reverse_proxy dya:8080
	}
	# ミニゲーム（UltraOSERO）。osero コンテナが動いていないときは /osero/ だけ 502 になり、お店には影響しない。
	# reverse_proxy は WebSocket(/osero/ws) も自動で通す。
	redir /osero /osero/ 308
	handle_path /osero/* {
		reverse_proxy osero:8080
	}
	handle {
		reverse_proxy app:8080
	}
}

# 同じサーバーで動く別のサイト（xbot の管理サイトなど）。ここは読み込むだけで、お店の設定には影響しない。
import /etc/caddy/sites/*.caddy
